# ─── Proletário Digital — variáveis de ambiente ───────────────────────────────
# Copie este ficheiro para .env.local e preencha com os valores reais.
# Nunca coloque .env.local no controlo de versões (já está no .gitignore).

# ── Contacto ──────────────────────────────────────────────────────────────────
VITE_WA_PHONE_NUMBER=244951461526
VITE_PHONE_NUMBER=244951461526
VITE_CONTACT_EMAIL=contacto@proletariodigital.com

# ── Redes Sociais ─────────────────────────────────────────────────────────────
VITE_SOCIAL_FACEBOOK=https://facebook.com/proletariodigital
VITE_SOCIAL_INSTAGRAM=https://instagram.com/proletariodigital
VITE_SOCIAL_LINKEDIN=https://linkedin.com/company/proletariodigital
VITE_SOCIAL_TIKTOK=

# ── WordPress / API ───────────────────────────────────────────────────────────
VITE_WP_API_URL=https://proletariodigital.sharingancode.site/index.php/wp-json/wp/v2

# ── Email — PRIORIDADE 1: WordPress ───────────────────────────────────────────
# Activa o envio via wp_mail() através de um endpoint REST personalizado.
# Ver snippet PHP/instruções em: src/lib/email/providers/WpEmailProvider.ts
VITE_WP_CONTACT_ENABLED=false
VITE_WP_CONTACT_NONCE=        # opcional — wp_create_nonce('wp_rest') no tema

# ── Email — PRIORIDADE 2: Web3Forms (Recomendado: grátis, sem código no servidor) 
# Obtenha uma access key gratuitamente em: https://web3forms.com
VITE_WEB3FORMS_KEY=

# ── Email — PRIORIDADE 3: Servidor próprio / endpoint HTTP ────────────────────
# Qualquer URL que aceite POST com JSON { name, email, subject, message }
VITE_EMAIL_API_URL=
VITE_EMAIL_API_SECRET=        # opcional — Bearer token

# ── Email — PRIORIDADE 4: EmailJS (cloud, gratuito até 200/mês) ───────────────
# https://emailjs.com — só activo se as prioridades anteriores estiverem vazias
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ── Nota: se nenhum estiver configurado, abre o cliente de email local ─────────
